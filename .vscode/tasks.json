{
	"version": "2.0.0",
	"tasks": [
		{
		"label": "Build mmpy with MSVC",
		"type": "shell",
		"command": "D:\\OneDrive\\Trading\\Market Making\\build\\build_msvc.bat",
		"args": [
			"${file}"
		],
		"options": {
			"shell": {
			"executable": "C:\\Windows\\System32\\cmd.exe",
			"args": ["/d", "/c"]
			}
		},
		"group": {
			"kind": "build",
			"isDefault": true
		},
		"problemMatcher": []
		},
		{
		"label": "Build mmpy with MSVC Zenbook",
		"type": "shell",
		"command": "C:\\Users\\brian\\OneDrive\\Trading\\Market Making\\build\\build_msvc_zenbook.bat",
